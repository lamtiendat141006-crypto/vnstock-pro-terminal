# Mẫu cấu hình biến môi trường cho SSI FastConnect Data API v2.0
# Hướng dẫn: Sao chép file này thành `.env` (cp .env.example .env) và điền khóa API của bạn vào.
SSI_BASE_URL=https://fc-data.ssi.com.vn/api/v2/Market
SSI_CONSUMER_ID=your_ssi_consumer_id_here
SSI_CONSUMER_SECRET=your_ssi_consumer_secret_here
SSI_PRIVATE_KEY=your_base64_rsa_xml_private_key_here
PORT=8080
